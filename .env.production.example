# 先用服务器 IP 测试时填 :80；域名备案/解析完成后改成你的域名，如 huoji.example.com
APP_HOST=:80

# 域名启用 HTTPS 时建议填写，用于证书通知；IP 测试阶段可留空
ACME_EMAIL=

APP_URL=http://YOUR_SERVER_IP

# 阿里云验证码 2.0：用于获取短信前的人机验证防刷。
# CAPTCHA_PROVIDER=none 时关闭；改为 aliyun 后启用。
CAPTCHA_PROVIDER=none
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_PREFIX=YOUR_ALIYUN_CAPTCHA_PREFIX
ALIYUN_CAPTCHA_SCENE_ID=YOUR_ALIYUN_CAPTCHA_SCENE_ID
ALIYUN_CAPTCHA_ACCESS_KEY_ID=YOUR_ALIYUN_ACCESS_KEY_ID
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=YOUR_ALIYUN_ACCESS_KEY_SECRET
ALIYUN_CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
ALIYUN_CAPTCHA_MODE=popup
ALIYUN_CAPTCHA_SCRIPT_URL=https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=12000

# 短信登录：mock 会把验证码返回给前端；上线真实短信可改为 aliyun 或 tencentcloud
SMS_PROVIDER=mock
SMS_DEV_CODE=
SMS_RESEND_COOLDOWN_SECONDS=60

# 阿里云短信。SMS_PROVIDER=aliyun 时必填。
# AccessKey 建议使用仅授权 dysms:SendSms 的 RAM 子账号密钥。
ALIYUN_SMS_ACCESS_KEY_ID=YOUR_ALIYUN_SMS_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_SECRET=YOUR_ALIYUN_SMS_ACCESS_KEY_SECRET
ALIYUN_SMS_SIGN_NAME=YOUR_APPROVED_ALIYUN_SMS_SIGN_NAME
ALIYUN_SMS_TEMPLATE_CODE=YOUR_APPROVED_TEMPLATE_CODE
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 按阿里云短信模板变量名填写。常见：
# 模板为 ${code}：code
# 模板为 ${code}、${ttl}：code,ttl
ALIYUN_SMS_TEMPLATE_PARAMS=code

# 腾讯云短信。SMS_PROVIDER=tencentcloud 时必填。
# SecretId / SecretKey 建议使用仅授权短信 SendSms 的子账号密钥。
TENCENTCLOUD_SECRET_ID=YOUR_TENCENTCLOUD_SECRET_ID
TENCENTCLOUD_SECRET_KEY=YOUR_TENCENTCLOUD_SECRET_KEY
TENCENT_SMS_SDK_APP_ID=YOUR_SMS_SDK_APP_ID
TENCENT_SMS_SIGN_NAME=YOUR_APPROVED_SMS_SIGN_NAME
TENCENT_SMS_TEMPLATE_ID=YOUR_APPROVED_TEMPLATE_ID
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com

# 按腾讯云短信模板变量顺序填写。常见：
# 模板只有 {1}=验证码：code
# 模板为 {1}=验证码、{2}=有效分钟数：code,ttl
TENCENT_SMS_TEMPLATE_PARAMS=code
