# DEEPSEEK_API_KEY: Required for real DeepSeek AI parsing.
# Without this key, /api/structure falls back to local offline parsing.
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# SMS_PROVIDER: mock returns the verification code to the frontend for local testing.
# Set SMS_PROVIDER="real" when a real SMS vendor is wired in.
SMS_PROVIDER="mock"
SMS_DEV_CODE=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
