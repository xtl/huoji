# DEEPSEEK_API_KEY: Required for real DeepSeek AI parsing.
# Without this key, /api/structure falls back to local offline parsing.
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# SMS_PROVIDER: mock returns the verification code to the frontend for local testing.
# Set SMS_PROVIDER="tencentcloud" to send real Tencent Cloud SMS codes.
SMS_PROVIDER="mock"
SMS_DEV_CODE=""
SMS_RESEND_COOLDOWN_SECONDS="60"

TENCENTCLOUD_SECRET_ID="YOUR_TENCENTCLOUD_SECRET_ID"
TENCENTCLOUD_SECRET_KEY="YOUR_TENCENTCLOUD_SECRET_KEY"
TENCENT_SMS_SDK_APP_ID="YOUR_SMS_SDK_APP_ID"
TENCENT_SMS_SIGN_NAME="YOUR_APPROVED_SMS_SIGN_NAME"
TENCENT_SMS_TEMPLATE_ID="YOUR_APPROVED_TEMPLATE_ID"
TENCENT_SMS_REGION="ap-guangzhou"
TENCENT_SMS_ENDPOINT="sms.tencentcloudapi.com"
TENCENT_SMS_TEMPLATE_PARAMS="code"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
